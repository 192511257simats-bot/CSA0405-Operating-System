# Optimised: multi-stage build, wheels built in stage 1, only runtime in stage 2
FROM python:3.12-slim AS build
WORKDIR /w
COPY requirements.txt .
RUN pip wheel --no-cache-dir --wheel-dir /wheels -r requirements.txt
FROM python:3.12-slim
WORKDIR /app
COPY --from=build /wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels flask gunicorn && rm -rf /wheels
COPY app.py .
RUN useradd -m portal && chown -R portal /app
USER portal
EXPOSE 8000
CMD ["gunicorn","-b","0.0.0.0:8000","app:app"]
